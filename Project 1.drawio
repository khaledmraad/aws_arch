        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;architecture-beta\n\t    group AWS_Cloud(cloud)[AWS Cloud]\n\t    group VPC(cloud)[VPC] in AWS_Cloud\n\t    group Public_Subnets(cloud)[Public Subnets]\n\t    group Private_Subnets(cloud)[Private Subnets]\n\t    group Data_Layer(cloud)[Data Layer]\n\t\n\t    service Internet_Users(internet)[Internet Users]\n\t    service Route_53(server)[Route 53] in AWS_Cloud\n\t    service Application_Load_Balancer(server)[Application Load Balancer] in Public_Subnets\n\t    service NAT_Gateway(server)[NAT Gateway] in Public_Subnets\n\t    service EC2_Auto_Scaling_Group(server)[EC2 Auto Scaling Group] in Private_Subnets\n\t    service EC2_Instance_1(server)[EC2 Instance 1] in Private_Subnets\n\t    service EC2_Instance_2(server)[EC2 Instance 2] in Private_Subnets\n\t    service EC2_Instance_3(server)[EC2 Instance 3] in Private_Subnets\n\t    service CloudWatch_Monitoring(server)[CloudWatch Monitoring] in AWS_Cloud\n\t    service Auto_Scaling_Policy(server)[Auto Scaling Policy] in AWS_Cloud\n\t    service RDS_Primary_Database(database)[RDS Primary Database] in Data_Layer\n\t    service RDS_Read_Replica(database)[RDS Read Replica] in Data_Layer\n\t    service ElastiCache_Redis(disk)[ElastiCache Redis] in Data_Layer\n\t    service S3_Bucket(disk)[S3 Bucket] in AWS_Cloud\n\t\n\t    Internet_Users:R --&gt; L:Route_53\n\t    Route_53:B --&gt; T:Application_Load_Balancer\n\t    Application_Load_Balancer:B --&gt; T:EC2_Instance_1\n\t    Application_Load_Balancer:B --&gt; T:EC2_Instance_2\n\t    Application_Load_Balancer:B --&gt; T:EC2_Instance_3\n\t    EC2_Instance_1:L --&gt; L:NAT_Gateway\n\t    EC2_Instance_2:L --&gt; L:NAT_Gateway\n\t    EC2_Instance_3:L --&gt; L:NAT_Gateway\n\t    EC2_Instance_1:B --&gt; T:RDS_Primary_Database\n\t    EC2_Instance_2:B --&gt; T:RDS_Primary_Database\n\t    EC2_Instance_3:B --&gt; T:RDS_Primary_Database\n\t    RDS_Primary_Database:R --&gt; L:RDS_Read_Replica\n\t    EC2_Instance_1:B --&gt; T:ElastiCache_Redis\n\t    EC2_Instance_2:B --&gt; T:ElastiCache_Redis\n\t    EC2_Instance_3:B --&gt; T:ElastiCache_Redis\n\t    EC2_Instance_1:R --&gt; L:S3_Bucket\n\t    CloudWatch_Monitoring:B --&gt; T:EC2_Instance_1\n\t    CloudWatch_Monitoring:B --&gt; T:EC2_Instance_2\n\t    CloudWatch_Monitoring:R --&gt; L:Auto_Scaling_Policy\n\t    Auto_Scaling_Policy:B --&gt; T:EC2_Auto_Scaling_Group&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iLhmyXpnD9kEHl7s8rKA-63">
